# 环境与部署
.env
backups/
# 部署同步脚本（各机自建：服务器别名与路径因机而异，README 里有模板）
scripts/sync-to-server.sh

# 前端
node_modules/
web/dist/
web/public/vditor/
*.local

# Go
server/bin/
*.test
*.out
# 种子题答案文件（*.in + *.out 数据对；曾随 *.out 漏提交，全新 clone 播种会缺答案）
!data/seed/**/*.out

# 前端 embed 产物（构建流程生成，.gitkeep 保留）
server/internal/webui/dist/*
!server/internal/webui/dist/.gitkeep

# 本地运行时产生的测试数据（正式数据在卷/服务器上）
/data/testdata/

# 本地测试题包中转站（data/test：hydro/topscoding 等待导入的 zip 一律放这里，
# 不入 git、不推服务器——题目的正仓库是 OJ 数据卷不是 git；sync-to-server.sh 同步排除）
/data/test/

# 日志与系统文件
*.log
.DS_Store
.zcode/

# 安全扫描器本地状态（Mimosa）
.mimosa/

# 只忽略根目录下的 md（不含子目录）
/*.md
# 但根目录的 README*.md / plan.md / notes.md 保留（开发文档入库）
!/README*.md
# 本地联调测试数据（判题样例自容器卷拷贝，不入库）
server/data/
