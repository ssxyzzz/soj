# 环境与部署
.env
backups/

# 前端
node_modules/
web/dist/
*.local

# Go
server/bin/
*.test
*.out

# 前端 embed 产物（构建流程生成，.gitkeep 保留）
server/internal/webui/dist/*
!server/internal/webui/dist/.gitkeep

# 本地运行时产生的测试数据（正式数据在卷/服务器上）
/data/testdata/

# 日志与系统文件
*.log
.DS_Store
.zcode/

# 只忽略根目录下的 md（不含子目录）
/*.md
# 但根目录的 README*.md 保留
!/README*.md